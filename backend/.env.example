# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Use the Supabase Session pooler URI (port 5432) for IPv4-only hosts.
# Use Direct connection only when the backend host supports IPv6.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR-USERNAME.github.io

# Set only for the one-time owner bootstrap command; never add these to
# the long-running API service. Remove them after the bootstrap completes.
ORGANIZATION_NAME=Nama Usaha
OWNER_NAME=Nama Pemilik
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=Use-A-Unique-Password-At-Least-12-Chars
