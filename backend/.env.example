# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR-USERNAME.github.io

# Set only for the one-time owner bootstrap command; do not add these to a running API service.
ORGANIZATION_NAME=Nama Usaha
OWNER_NAME=Nama Pemilik
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=Use-A-Unique-Password-At-Least-12-Chars
